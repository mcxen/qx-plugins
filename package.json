{
  "name": "qx-plugins",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "convert:raycast": "node scripts/convert-raycast-extension.mjs",
    "convert:raycast-url": "node scripts/convert-raycast-url.mjs",
    "build:qxcoolapk": "esbuild src/qxcoolapk/index.source.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=inline --outfile=src/qxcoolapk/index.js",
    "build:qxtieba": "esbuild src/qxtieba/index.source.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=inline --outfile=src/qxtieba/index.js",
    "build:qxweibo": "esbuild src/qxweibo/index.source.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=inline --outfile=src/qxweibo/index.js",
    "build:agent-usage": "esbuild src/agent-usage/index.source.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=inline --outfile=src/agent-usage/index.js",
    "build:another-boring-piece": "esbuild src/another-boring-piece/index.source.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=inline --outfile=src/another-boring-piece/index.js",
    "build:plugins": "npm run build:qxcoolapk && npm run build:qxtieba && npm run build:qxweibo && npm run build:agent-usage && npm run build:another-boring-piece",
    "package:plugins": "npm run build:plugins && node scripts/package-plugins.mjs",
    "package:one": "node scripts/package-plugins.mjs",
    "store:dev": "npm --prefix store run dev",
    "store:build": "npm --prefix store run build",
    "store:pages": "npm --prefix store run pages:dev",
    "smoke:qxheihe": "node scripts/smoke-qxheihe.mjs",
    "smoke:qxtieba": "node scripts/smoke-qxtieba.mjs",
    "smoke:qxcoolapk": "npm run build:qxcoolapk && node scripts/smoke-qxcoolapk.mjs",
    "smoke:qxweibo": "npm run build:qxweibo && node scripts/smoke-qxweibo.mjs",
    "smoke:qxgh": "node scripts/smoke-qxgh.mjs",
    "smoke:qxpicture": "node scripts/smoke-qxpicture.mjs",
    "smoke:clipboard-actions": "node scripts/smoke-clipboard-actions.mjs",
    "smoke:bing-wallpaper": "node scripts/smoke-qx-bing-wallpaper.mjs",
    "smoke:sysinfo": "node scripts/smoke-sysinfo.mjs",
    "smoke:agent-usage": "npm run build:agent-usage && node scripts/smoke-agent-usage.mjs",
    "smoke:another-boring-piece": "npm run build:another-boring-piece && node scripts/smoke-another-boring-piece.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yazl": "^3.3.1"
  }
}
