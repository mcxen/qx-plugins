{
  "id": "raycast-calendar",
  "name": "Quick Calendar",
  "names": {
    "en": "Quick Calendar",
    "zh-CN": "快捷日历"
  },
  "version": "1.2.4",
  "description": "View calendar month-by-month",
  "descriptions": {
    "en": "View calendar month-by-month",
    "zh-CN": "按月浏览日历。"
  },
