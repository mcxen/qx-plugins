{
  "id": "brew",
  "name": "Brew",
  "version": "1.1.3",
  "description": "Search, inspect, upgrade and uninstall Homebrew formulae & casks (macOS). Uses Qx context.cli.",
  "names": {
    "en": "Brew",
    "zh-CN": "Homebrew"
  },
  "descriptions": {
    "en": "Search, inspect, upgrade and uninstall Homebrew formulae and casks on macOS.",
    "zh-CN": "在 macOS 上搜索、查看、更新和卸载 Homebrew formula 与 cask。"
  },
  "author": "qx (ported from Raycast brew by nhojb et al.)",
  "icon": "icon-generated.png",
  "screenshots": [
    "brew-1.png",
    "brew-2.png"
  ],
  "platforms": [
    "macos"
  ],
  "keywords": [
    "brew",
    "homebrew",
    "formula",
    "cask",
    "package",
    "install",
    "upgrade",
    "macos"
  ],
  "permissions": [
    "cli",
    "notifications",
    "open-url"
  ],
  "preferences": [
    {
      "id": "brewPath",
      "label": "Brew executable",
      "labels": {
        "en": "Brew executable",
        "zh-CN": "Brew 可执行文件"
      },
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional absolute path to brew. Empty = auto-detect (/opt/homebrew/bin/brew, /usr/local/bin/brew, PATH).",
      "descriptions": {
        "en": "Optional absolute path to brew. Empty = auto-detect.",
        "zh-CN": "可选的 brew 绝对路径。留空时自动检测。"
      }
    }
  ],
  "entry": "index.js",
  "panel": {
    "title": "Brew",
    "titles": {
      "en": "Brew",
      "zh-CN": "Homebrew"
    },
    "icon": "icon-generated.png",
    "keywords": [
      "brew",
      "homebrew",
      "cask"
    ]
  },
  "min_app_version": "0.5.39",
  "raycast": {
    "source": "brew",
    "compatible": "native-cli-port",
    "sourceCommit": "a1f6fad4defba0d8c07a4c3e411edc7779702e4c",
    "sourceUrl": "https://github.com/raycast/extensions/tree/a1f6fad4defba0d8c07a4c3e411edc7779702e4c/extensions/brew",
    "platformCompatibility": {
      "macos": {
        "status": "supported",
        "features": [
          "context.cli",
          "Homebrew list/info/search/outdated/upgrade/uninstall",
          "Panel UI"
        ],
        "degraded": [],
        "unsupported": [
          "Raycast menu-bar services command",
          "Full Raycast metadata panel parity"
        ]
      },
      "windows": {
        "status": "unsupported",
        "features": [],
        "unsupported": [
          "Homebrew is macOS-only in this packaging"
        ]
      }
    }
  }
}
