{
  "id": "qxpicture",
  "name": "Qxpicture",
  "names": {
    "zh-CN": "Qxpicture 随机图片",
    "en": "Qxpicture"
  },
  "version": "0.5.6",
  "description": "Browse random image APIs, save images, copy them, and set desktop wallpaper.",
  "descriptions": {
    "zh-CN": "浏览随机图片 API，保存或复制图片，并设置桌面壁纸。",
    "en": "Browse random image APIs, save images, copy them, and set desktop wallpaper."
  },
  "author": "Qx",
  "icon": "icon-generated.png",
  "platforms": [
    "macos",
    "windows"
  ],
  "keywords": [
    "random image",
    "wallpaper",
    "picture",
    "api",
    "随机图片",
    "壁纸",
    "suijitupian",
    "sjtp",
    "图片",
    "tupian",
    "tp",
    "随机",
    "suiji",
    "sj",
    "bizhi",
    "bz"
  ],
  "permissions": [
    "storage",
    "http",
    "cli",
    "system",
    "clipboard",
    "notifications",
    "invoke:plugin_file_ensure_dir",
    "invoke:plugin_file_write_base64",
    "invoke:clipboard_write_image_file"
  ],
  "parameter_schema": {
    "storageField": "sources[].params",
    "item": {
      "key": {
        "type": "text",
        "required": true
      },
      "value": {
        "type": "text",
        "required": false
      },
      "type": {
        "type": "select",
        "default": "text",
        "options": [
          "text",
          "number",
          "boolean",
          "select"
        ]
      },
      "options": {
        "type": "array",
        "item": {
          "label": {
            "type": "text"
          },
          "value": {
            "type": "text"
          }
        }
      }
    },
    "transports": [
      "query",
      "json-body"
    ],
    "responses": [
      "image",
      "json-url",
      "json-base64"
    ]
  },
  "entry": "index.js",
  "panel": {
    "icon": "icon-generated.png",
    "title": "Qxpicture",
    "titles": {
      "en": "Qxpicture",
      "zh-CN": "Qxpicture 随机图片"
    },
    "keywords": [
      "random image",
      "wallpaper",
      "api",
      "随机图片",
      "壁纸"
    ]
  },
